{
  "name": "call-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI Voice/Call Agent System – root Node/TypeScript tooling",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "apps/ui"
  ]
}
