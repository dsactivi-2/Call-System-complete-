# =============================================================================
# AI Voice/Call Agent System – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
SECRET_KEY=change-me-in-production     # Used for JWT signing; generate with: openssl rand -hex 32
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callsystem

# ---------------------------------------------------------------------------
# Cache / Task Queue (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Telephony Provider
# ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=asterisk            # asterisk | telnyx | twilio
ASTERISK_ARI_URL=http://localhost:8088
ASTERISK_ARI_USERNAME=admin
ASTERISK_ARI_PASSWORD=changeme
# TELNYX_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# LLM / AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=                        # Required for LLM features
OPENAI_MODEL=gpt-4o-mini               # Default model
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Speech-to-Text
# ---------------------------------------------------------------------------
STT_PROVIDER=whisper                   # whisper | deepgram | assemblyai
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# CRM Integration
# ---------------------------------------------------------------------------
CRM_PROVIDER=hubspot                   # hubspot | salesforce | custom
HUBSPOT_API_KEY=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_INSTANCE_URL=

# ---------------------------------------------------------------------------
# Calendar Integration
# ---------------------------------------------------------------------------
CALENDAR_PROVIDER=google               # google | m365 | caldav
GOOGLE_CALENDAR_CREDENTIALS_JSON=      # Path to service account JSON or inline JSON
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Ticketing Integration
# ---------------------------------------------------------------------------
TICKETING_PROVIDER=zendesk             # zendesk | freshdesk | jira
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# FRESHDESK_DOMAIN=
# FRESHDESK_API_KEY=
# JIRA_SERVER_URL=
# JIRA_USER_EMAIL=
# JIRA_API_TOKEN=

# ---------------------------------------------------------------------------
# Object Storage (Recordings)
# ---------------------------------------------------------------------------
S3_BUCKET=call-recordings
S3_ENDPOINT_URL=                       # Leave empty for AWS; set for MinIO / Backblaze
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Compliance / Recording
# ---------------------------------------------------------------------------
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=90
CONSENT_DISCLOSURE_AUDIO_URL=          # URL to consent announcement audio file
