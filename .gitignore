# =============================================================================
# AI Voice/Call Agent System – .gitignore
# Covers: OS artifacts, IDEs, Python, Node/TS, Docker temp, Logs, Secrets
# =============================================================================

# -----------------------------------------------------------------------------
# OS – macOS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# -----------------------------------------------------------------------------
# OS – Windows
# -----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# -----------------------------------------------------------------------------
# OS – Linux temp
# -----------------------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# IDE – VS Code
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace

# -----------------------------------------------------------------------------
# IDE – JetBrains (PyCharm, IntelliJ, WebStorm, …)
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# -----------------------------------------------------------------------------
# IDE – Cursor AI
# -----------------------------------------------------------------------------
.cursorignore
.cursorindexingignore

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Packaging / distribution
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Linters / formatters
.ruff_cache/

# Jupyter
.ipynb_checkpoints

# Celery
celerybeat-schedule
celerybeat.pid

# Cython
cython_debug/

# Misc tooling
.pdm-python
.pdm-build/
.pixi
__pypackages__/
.pypirc
.abstra/
marimo/_static/
marimo/_lsp/
__marimo__/

# -----------------------------------------------------------------------------
# Node / TypeScript / Frontend tooling
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.cjs
.pnp.loader.mjs

# Build outputs
dist/
build/
.next/
.nuxt/
.output/
.svelte-kit/

# Cache / tooling
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
.parcel-cache/

# Coverage
coverage/
*.lcov

# Misc Node
.npmrc.local
.yarnrc.local

# -----------------------------------------------------------------------------
# Docker / Infra temp
# -----------------------------------------------------------------------------
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Logs & temp output
# -----------------------------------------------------------------------------
*.log
*.log.*
logs/
/tmp/
temp/
tmp/

# Call recordings & transcripts (NEVER commit real audio/PII)
recordings/
transcripts_raw/
*.wav
*.mp3
*.ogg
*.opus
*.flac

# -----------------------------------------------------------------------------
# Secrets & credentials
# IMPORTANT: .env.example is explicitly NOT ignored (see below)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Sphinx
docs/_build/

# mkdocs
/site
